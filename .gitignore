# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Secrets
.env
.env.*
!.env.example

# Data: never commit raw candidate recordings or derived artifacts.
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Media files anywhere in the repo (tests generate their own fixtures at runtime)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.m4a

# OS / editors
.DS_Store
.idea/
.vscode/
*.ipynb_checkpoints
