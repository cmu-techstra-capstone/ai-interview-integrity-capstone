# Copy to `.env` and fill in locally. Never commit `.env`.

# --- Multi-LLM gateway (not wired up yet; see src/interview_integrity/llm/) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Speech-to-text provider (pending team decision; see docs/decisions.md) ---
# TRANSCRIPTION_PROVIDER=sidecar

# --- Localhost development API (Phase 4+) ---
# Always loopback. Do not set API_HOST to 0.0.0.0.
INTERVIEW_INTEGRITY_API_HOST=127.0.0.1
INTERVIEW_INTEGRITY_API_PORT=8765
INTERVIEW_INTEGRITY_RECORDINGS_DIR=data/authorized_recordings
# Comma-separated. After loading the unpacked extension, copy its ID from chrome://extensions:
# INTERVIEW_INTEGRITY_API_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
INTERVIEW_INTEGRITY_API_ALLOWED_ORIGINS=

# --- Live Meet tab-audio (Phase 6; in-memory only) ---
# INTERVIEW_INTEGRITY_LIVE_DEFAULT_STT=faster-whisper-small-int8
# INTERVIEW_INTEGRITY_LIVE_MAX_SESSIONS=2
# INTERVIEW_INTEGRITY_LIVE_MAX_CHUNK_BYTES=262144
# INTERVIEW_INTEGRITY_LIVE_MAX_SESSION_BYTES=8388608
# For automated tests / laptop without weights:
# INTERVIEW_INTEGRITY_LIVE_DEFAULT_STT=fake-live
